{
  "name": "G4AL",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "containerEnv": {
    "SDL_AUDIODRIVER": "dummy",
    "G4AL_HOST": "0.0.0.0"
  },
  "forwardPorts": [8000],
  "postCreateCommand": "make install",
  "customizations": {
    "vscode": {
      "extensions": ["charliermarsh.ruff", "ms-python.python", "ms-python.mypy-type-checker"]
    }
  }
}
