# OS / OUTILS (VS Code, etc.)
# =========================

# Fichiers système
.DS_Store
Thumbs.db

# Fichiers de configuration de l'éditeur (VS Code)
.vscode/

# logs
logs/
# Tooling
.venv/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Claude Code (local only)
.claude/settings.local.json
.claude/worktrees/

# mr-review output (never committed)
*_TO_*_review.md
